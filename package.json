{
  "name": "wsc-crypto-ts",
  "version": "2.0.0",
  "description": "Dependency-free TypeScript helpers for WoltLab Suite Core cryptographic wire formats.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "Sascha Greuel <hello@1-2.dev>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftCreatR/wsc-crypto-ts.git"
  },
  "homepage": "https://github.com/SoftCreatR/wsc-crypto-ts#readme",
  "bugs": {
    "url": "https://github.com/SoftCreatR/wsc-crypto-ts/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage",
    "prepack": "npm test"
  },
  "keywords": [
    "cryptography",
    "typescript",
    "woltlab",
    "wsc",
    "crypto",
    "hmac"
  ],
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
